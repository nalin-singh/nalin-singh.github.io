---
/**
 * A drawn arrow for buttons and links. Arrow characters like ↗ fall back to the emoji font on
 * iPhones, so the site draws its arrows instead. Sized and coloured by the surrounding text.
 */
interface Props {
  to?: "ne" | "n" | "e" | "w";
}

const { to = "ne" } = Astro.props;
const paths = {
  ne: "M3 9 9 3M4.2 3H9v4.8",
  n: "M6 10.5V1.5M2.2 5.3 6 1.5l3.8 3.8",
  e: "M1.5 6h9M6.7 2.2 10.5 6l-3.8 3.8",
  w: "M10.5 6h-9M5.3 2.2 1.5 6l3.8 3.8",
};
---

<svg class="arw" viewBox="0 0 12 12" aria-hidden="true">
  <path d={paths[to]}></path>
</svg>
