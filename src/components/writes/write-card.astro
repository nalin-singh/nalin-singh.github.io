---
import type { CollectionEntry } from "astro:content";

import Arrow from "~/components/ui/arrow.astro";
import { icons, tones } from "~/data/icons";
import { roughen } from "~/lib/rough";

import "~/styles/write-card.css";

/** A write as a coloured card: topic and length, a sketched icon, the title, a dek and a Read button. */
interface Props {
  post: CollectionEntry<"writes">;
  label: string;
  wide?: boolean;
  cta?: string;
  arrow?: "ne" | "e";
}

const { post, label, wide = false, cta = "Read", arrow = "ne" } = Astro.props;
const { topic, minutes, draft, icon, title, description } = post.data;
---

<a class:list={["wcard", { wide }]} href={`/writes/${post.id}/`} style={`--c:${tones[topic]}`}>
  <span class="top mono">
    <span>{label}</span>
    <span>
      {minutes} min{draft ? " · draft" : ""}
    </span>
  </span>
  <svg
    class="wicon"
    viewBox="0 0 64 64"
    aria-hidden="true"
    set:html={roughen(icons[icon], "wobble")}
  />
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="rd">
    <span class="back"></span>
    <span class="face">
      {cta} <Arrow to={arrow} />
    </span>
  </span>
</a>
