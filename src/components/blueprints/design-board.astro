---
import Rough from "~/components/ui/rough.astro";
import { sketches } from "~/data/sketches";

import "~/styles/board.css";
---

<article class="board wide" data-board>
  <div class="patch" aria-label="Patch: college years, 2019 to 2023">
    <Rough look="edge-sm">
      <svg viewBox="0 0 160 160" aria-hidden="true">
        <defs>
          <path id="pring" d="M80 80 m-56 0 a56 56 0 1 1 112 0 a56 56 0 1 1 -112 0" />
        </defs>
        <circle cx="80" cy="80" r="76" fill="#8e3c22" />
        <circle
          cx="80"
          cy="80"
          r="70"
          fill="none"
          stroke="#e4d9c0"
          stroke-width="2"
          stroke-dasharray="4 3"
        />
        <circle cx="80" cy="80" r="40" fill="#2f2c28" />
        <circle
          cx="80"
          cy="80"
          r="36"
          fill="none"
          stroke="#e4d9c0"
          stroke-width="1.5"
          stroke-dasharray="3 3"
        />
        <path d="M80 54 L96 86 L88 104 H72 L64 86 Z" fill="#e4d9c0" />
        <path d="M80 54 V84" stroke="#2f2c28" stroke-width="3" />
        <circle cx="80" cy="88" r="4" fill="#2f2c28" />
        <text font-family="Martian Mono, monospace" font-size="10.5" fill="#e4d9c0">
          <textPath href="#pring" textLength="344" lengthAdjust="spacing">
            COLLEGE YEARS · FREELANCE · 2019–23 ·
          </textPath>
        </text>
      </svg>
    </Rough>
  </div>
  <div class="top mono">
    <span>Board 04 · Design</span>
    <span>Before production code</span>
  </div>
  <h3>Design archive</h3>
  <p>
    Websites and apps for clients, all through college: kpimedia.co as KPI Media's only designer, a
    social app for surfers, and a shoe store's whole shop. It's where the habit of sitting with
    users comes from.
  </p>
  <div class="atoggle mono" role="tablist" aria-label="How to show the design work">
    <button type="button" role="tab" aria-selected="true" data-a="a">
      Collage
    </button>
    <button type="button" role="tab" aria-selected="false" data-a="b">
      Sketch → screen
    </button>
  </div>
  <div class="arch-a">
    <div class="dwgwrap">
      <Rough>
        <svg
          class="canvas"
          viewBox="0 0 760 390"
          aria-label="A loose design board: taped-up screens for kpimedia.co, a surf app and a shoe store, a reference photo, a paint swatch strip, a type scrap, a client note and chalk markups"
        >
          <!-- reference polaroid, behind the surf app -->
          <g class="ab" style="--i:0">
            <g transform="rotate(9 520 120)">
              <rect x="468" y="52" width="104" height="124" fill="#f6f1e6" data-rough="edge-sm" />
              <rect x="476" y="60" width="88" height="88" fill="#2f5d63" />
              <path
                d="M476 120 C496 104 512 128 532 112 S556 108 564 114 V148 H476Z"
                fill="#8ea676"
              />
              <circle cx="546" cy="80" r="9" fill="#e4d9c0" />
              <text x="480" y="166" class="hand">
                surf trip ref
              </text>
            </g>
          </g>
          <!-- kpimedia home, taped -->
          <g class="ab" style="--i:1">
            <g transform="rotate(-3.5 190 150)">
              <text x="34" y="44" class="fname">
                kpimedia.co — Home
              </text>
              <rect x="30" y="50" width="318" height="206" fill="#efe6d2" data-rough="edge-sm" />
              <rect x="30" y="50" width="318" height="22" fill="#211c16" />
              <circle cx="46" cy="61" r="4" fill="#d8612a" />
              <rect x="250" y="58" width="86" height="6" fill="#e4d9c0" opacity=".7" />
              <rect x="48" y="92" width="170" height="20" fill="#211c16" />
              <rect x="48" y="118" width="132" height="20" fill="#211c16" />
              <rect x="48" y="150" width="150" height="5" fill="#6a6258" />
              <rect x="48" y="161" width="120" height="5" fill="#6a6258" />
              <rect x="48" y="182" width="70" height="22" rx="11" fill="#d8612a" />
              <rect x="232" y="92" width="98" height="140" fill="#2f5d63" />
              <circle cx="281" cy="146" r="26" fill="#c49a45" />
              <rect x="48" y="222" width="40" height="22" fill="#cfc3a6" />
              <rect x="96" y="222" width="40" height="22" fill="#cfc3a6" />
              <rect x="144" y="222" width="40" height="22" fill="#cfc3a6" />
            </g>
            <rect class="tape" x="12" y="40" width="54" height="16" transform="rotate(-30 39 48)" />
            <rect
              class="tape t2"
              x="314"
              y="236"
              width="54"
              height="16"
              transform="rotate(-18 341 244)"
            />
          </g>
          <!-- surf app, overlapping -->
          <g class="ab" style="--i:2">
            <g transform="rotate(4.5 446 170)">
              <text x="388" y="48" class="fname">
                Surf app — Feed
              </text>
              <rect x="386" y="56" width="122" height="236" rx="14" fill="#efe6d2" />
              <rect x="386" y="56" width="122" height="108" rx="14" fill="#2f5d63" />
              <rect x="386" y="134" width="122" height="30" fill="#2f5d63" />
              <path
                d="M386 142 C406 128 426 152 448 136 S490 130 508 138 V164 H386Z"
                fill="#8ea676"
              />
              <circle cx="484" cy="84" r="12" fill="#e4d9c0" />
              <circle cx="404" cy="182" r="9" fill="#8e3c22" />
              <rect x="418" y="176" width="60" height="5" fill="#211c16" />
              <rect x="418" y="185" width="40" height="4" fill="#6a6258" />
              <rect x="400" y="204" width="94" height="40" rx="6" fill="#d8c58c" />
              <rect x="408" y="214" width="50" height="5" fill="#211c16" />
              <rect x="408" y="224" width="70" height="4" fill="#6a6258" />
              <rect x="400" y="256" width="94" height="22" rx="11" fill="#211c16" />
              <rect
                x="382"
                y="52"
                width="130"
                height="244"
                rx="2"
                fill="none"
                stroke="#0d99ff"
                stroke-width="1.5"
                class="sel"
              />
              <g class="sel">
                <rect x="378" y="48" width="8" height="8" fill="#fff" stroke="#0d99ff" />
                <rect x="508" y="48" width="8" height="8" fill="#fff" stroke="#0d99ff" />
                <rect x="378" y="292" width="8" height="8" fill="#fff" stroke="#0d99ff" />
                <rect x="508" y="292" width="8" height="8" fill="#fff" stroke="#0d99ff" />
              </g>
            </g>
            <rect
              class="tape t3"
              x="460"
              y="40"
              width="50"
              height="15"
              transform="rotate(22 485 47)"
            />
          </g>
          <!-- shoe store, lower right -->
          <g class="ab" style="--i:3">
            <g transform="rotate(-2.5 640 250)">
              <text x="548" y="186" class="fname">
                Shoe store — Product
              </text>
              <rect x="544" y="194" width="196" height="150" fill="#efe6d2" data-rough="edge-sm" />
              <rect x="556" y="206" width="92" height="96" fill="#c9b994" />
              <path
                d="M564 280 C578 278 590 266 600 256 C608 264 620 268 636 270 C642 272 642 284 636 286 H566 C560 286 560 280 564 280Z"
                fill="#8e3c22"
              />
              <rect x="660" y="210" width="66" height="10" fill="#211c16" />
              <rect x="660" y="228" width="44" height="6" fill="#6a6258" />
              <circle cx="666" cy="250" r="6" fill="#211c16" />
              <circle cx="682" cy="250" r="6" fill="#2f5d63" />
              <circle cx="698" cy="250" r="6" fill="#8e3c22" />
              <rect x="660" y="272" width="70" height="22" rx="11" fill="#211c16" />
              <rect x="556" y="312" width="172" height="5" fill="#6a6258" />
              <rect x="556" y="323" width="120" height="5" fill="#6a6258" />
            </g>
            <rect
              class="tape"
              x="706"
              y="180"
              width="50"
              height="15"
              transform="rotate(28 731 187)"
            />
          </g>
          <!-- paint swatch strip -->
          <g class="ab" style="--i:4">
            <g transform="rotate(-9 92 320)">
              <rect x="40" y="276" width="140" height="92" fill="#f6f1e6" data-rough="edge-sm" />
              <rect x="48" y="284" width="30" height="56" fill="#211c16" />
              <rect x="80" y="284" width="30" height="56" fill="#d8612a" />
              <rect x="112" y="284" width="30" height="56" fill="#2f5d63" />
              <rect x="144" y="284" width="28" height="56" fill="#c49a45" />
              <text x="48" y="356" class="hex dark">
                #211C16 · #D8612A
              </text>
            </g>
          </g>
          <!-- type scrap -->
          <g class="ab" style="--i:5">
            <g transform="rotate(3 280 330)">
              <path d="M206 290 L346 284 L352 372 L210 378 Z" fill="#efe6d2" data-rough="edge-sm" />
              <text x="218" y="350" class="aa">
                Aa
              </text>
              <text x="282" y="322" class="hex dark">
                Display 900
              </text>
              <text x="282" y="338" class="hex dark">
                Body 400
              </text>
            </g>
          </g>
          <!-- client note -->
          <g class="ab" style="--i:6">
            <g transform="rotate(-6 440 352)">
              <rect x="380" y="312" width="124" height="74" fill="#d8c58c" />
              <text x="392" y="336" class="note">
                Client:
              </text>
              <text x="392" y="354" class="note">
                can the logo
              </text>
              <text x="392" y="372" class="note">
                be bigger?
              </text>
            </g>
          </g>
          <!-- chalk markups -->
          <g class="chalk">
            <path
              class="ck"
              d="M38 70 C30 52 60 44 66 62 C70 78 44 84 40 70"
              style="--len:120;--d:1.1s"
            />
            <path class="ck" d="M378 330 C300 300 190 210 78 84" style="--len:420;--d:1.3s" />
            <path class="ck" d="M90 82 l-10 -4 m10 4 l-4 9" style="--len:30;--d:1.7s" />
            <text x="196" y="283" class="hand light">
              bigger? really?
            </text>
            <path class="ck" d="M548 352 C600 362 660 362 720 350" style="--len:180;--d:1.5s" />
            <text x="610" y="378" class="hand light">
              v3_final_FINAL
            </text>
          </g>
          <path
            id="cur-a"
            d="M300 210 C360 160 440 300 470 220 C500 140 640 130 690 180 C720 220 600 320 520 320 C420 320 330 280 300 210Z"
            fill="none"
          />
          <path
            id="cur-b"
            d="M650 300 C600 250 560 120 470 100 C380 80 260 160 160 140 C80 120 120 300 240 320 C360 340 600 340 650 300Z"
            fill="none"
          />
          <g id="cursor-a" class="cursor">
            <path
              d="M0 0 L0 17 L5 12 L9 21 L12 19 L8 11 L15 11 Z"
              fill="#0d99ff"
              stroke="#fff"
              stroke-width="1"
            />
            <rect x="14" y="16" width="40" height="15" rx="3" fill="#0d99ff" />
            <text x="20" y="27" class="cname">
              Nalin
            </text>
          </g>
          <g id="cursor-b" class="cursor">
            <path
              d="M0 0 L0 17 L5 12 L9 21 L12 19 L8 11 L15 11 Z"
              fill="#d8612a"
              stroke="#fff"
              stroke-width="1"
            />
            <rect x="14" y="16" width="42" height="15" rx="3" fill="#d8612a" />
            <text x="20" y="27" class="cname">
              Client
            </text>
          </g>
        </svg>
      </Rough>
    </div>
  </div>
  <div class="arch-b" hidden>
    <div class="s2s-pick mono" role="group" aria-label="Choose a project">
      {sketches.map((item, i) => (
        <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-p={item.id}>
          {item.label}
        </button>
      ))}
    </div>
    <div class="s2s" id="s2s">
      <div class="s2s-layer final" id="s2s-final">
        {sketches.map((item, i) => (
          <div class="s2s-pane" data-p={item.id} hidden={i !== 0}>
            <svg
              viewBox="0 0 640 380"
              preserveAspectRatio="xMidYMid slice"
              aria-hidden="true"
              set:html={item.screen}
            />
          </div>
        ))}
      </div>
      <div class="s2s-layer sketch" id="s2s-sketch">
        {sketches.map((item, i) => (
          <div class="s2s-pane" data-p={item.id} hidden={i !== 0}>
            <svg
              viewBox="0 0 640 380"
              preserveAspectRatio="xMidYMid slice"
              aria-hidden="true"
              set:html={item.sketch}
            />
          </div>
        ))}
      </div>
      <div
        class="s2s-handle"
        id="s2s-handle"
        role="slider"
        tabindex="0"
        aria-label="Sketch to screen"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
      >
        <i></i>
        <span class="mono">◀ ▶</span>
      </div>
      <span class="s2s-tag l mono">Sketch</span>
      <span class="s2s-tag r mono">Screen</span>
    </div>
    {sketches.map((item, i) => (
      <p class="s2s-note" data-p={item.id} hidden={i !== 0}>
        {item.note}
      </p>
    ))}
  </div>
  <div class="tabs mono" aria-label="Files">
    <span class="on">kpimedia.fig</span>
    <span>surf-app.fig</span>
    <span>shoe-store.fig</span>
    <span>webflow-rebuilds.fig</span>
  </div>
  <a class="press more" href="/#work">
    <span class="back"></span>
    <span class="face">Open the archive ↗</span>
  </a>
</article>

<script>
  import { startBoard } from "~/scripts/board";

  startBoard();
</script>
