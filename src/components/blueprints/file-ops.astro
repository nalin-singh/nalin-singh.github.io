---
import Rough from "~/components/ui/rough.astro";
---

<article class="bp" data-bp>
  <div class="top mono">
    <span>Drawing NS-03 · AI</span>
    <span>Koch Industries</span>
  </div>
  <h3>File-Ops</h3>
  <p>
    A document AI pipeline that reads tables properly. Long jobs moved onto a queue with retries,
    and failures land somewhere you can see them.
  </p>
  <div class="dwgwrap">
    <Rough look="wobble" only={["ln", "dash", "hot"]}>
      <svg
        class="dwg"
        viewBox="0 0 520 230"
        aria-label="Diagram: PDFs go to a queue, then to workers that use Textract and an LLM to produce structured tables. Jobs retry up to three times, then move to dead letters."
      >
        <path class="ln soft" d="M32 56 H70 L84 70 V128 Q84 132 80 132 H36 Q32 132 32 128 Z" />
        <path
          class="ln draw"
          d="M24 66 H62 L78 82 V140 Q78 144 74 144 H28 Q24 144 24 140 V70 Q24 66 28 66 Z"
          style="--d:0s"
        />
        <path class="ln draw" d="M62 66 V78 Q62 82 66 82 H78" style="--d:.15s" />
        <path class="ln thin draw" d="M33 96 H68 M33 106 H62 M33 116 H66" style="--d:.25s" />
        <rect class="ln thin draw" x="33" y="124" width="26" height="11" style="--d:.3s" />
        <text x="24" y="164" class="dim">
          PDFS IN
        </text>
        <path id="fo-1" class="ln draw" d="M80 104 C100 97 120 111 140 104" style="--d:.35s" />
        <rect rx="12" class="ln draw" x="140" y="80" width="92" height="46" style="--d:.4s" />
        <rect class="slot on" x="150" y="92" width="14" height="22" rx="2" />
        <rect class="slot on" x="168" y="92" width="14" height="22" rx="2" />
        <rect class="slot" x="186" y="92" width="14" height="22" rx="2" />
        <rect class="slot" x="204" y="92" width="14" height="22" rx="2" />
        <text x="160" y="144">
          QUEUE
        </text>
        <path id="fo-2" class="ln draw" d="M232 104 C246 97 262 111 276 104" style="--d:.5s" />
        <rect rx="12" class="ln soft" x="286" y="64" width="98" height="56" />
        <rect rx="12" class="ln draw" x="276" y="74" width="98" height="56" style="--d:.55s" />
        <text x="286" y="98">
          WORKERS
        </text>
        <text x="286" y="114" class="dim tight">
          TEXTRACT + LLM
        </text>
        <path id="fo-3" class="ln draw" d="M374 102 C388 95 406 109 420 102" style="--d:.65s" />
        <rect rx="12" class="ln draw" x="420" y="62" width="88" height="78" style="--d:.7s" />
        <rect class="fillhead" x="421" y="63" width="86" height="18" />
        <rect class="fillmerge" x="421" y="81" width="28" height="58" />
        <path
          class="ln thin draw"
          d="M420 81 H508 M449 100 H508 M449 120 H508 M449 62 V140 M478 62 V140"
          style="--d:.85s"
        />
        <text x="508" y="160" class="dim" text-anchor="end">
          MERGED CELLS ✓
        </text>
        <path id="fo-retry" class="dash" d="M326 74 C328 18 184 18 186 80" />
        <text x="216" y="34" class="red">
          RETRY × 3
        </text>
        <path class="dash" d="M326 130 C328 180 292 180 232 178" />
        <path
          class="ln draw"
          d="M198 168 H226 L222 196 H202 Z M194 168 H230 M206 162 H218"
          style="--d:1s"
        />
        <text x="186" y="214" class="dim">
          DEAD LETTERS
        </text>
      </svg>
    </Rough>
  </div>
  <a class="press more" href="/#work">
    <span class="back"></span>
    <span class="face">Read ↗</span>
  </a>
</article>
