---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import PostLayout from "~/layouts/post-layout.astro";
import { ordered } from "~/lib/writes";

export const getStaticPaths = (async () => {
  const posts = await ordered();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[(i + 1) % posts.length] },
  }));
}) satisfies GetStaticPaths;

const { post, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} next={next}>
  <Content />
</PostLayout>
