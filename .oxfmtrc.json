{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "dist",
    ".astro",
    "design",
    "src/content",
    "docs/writing.md",
    "pnpm-lock.yaml"
  ],
  "astro": true
}
